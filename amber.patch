+++ b/pkg/service/soundtouchweb/static/css/amber.css
@@ -0,0 +1,124 @@
+/* Theme for the speaker screen. Admin and catalog views use upstream styles. */
+.device-detail {
+    color-scheme: dark;
+    --bg: #131110;
+    --surface: #211e1c;
+    --border: #423933;
+    --text: #fff6ec;
+    --text-dim: #c6b8ab;
+    --accent: #ffc17b;
+    --accent-fg: #21160d;
+    --fav: #ffc17b;
+    --fav-bright: #ffdaab;
+    --danger: #ffaaa0;
+    --success: #8dd6a9;
+    --warning: #ffcd84;
+    --content-icon-filter: brightness(0) invert(1);
+    --content-icon-filter-alt: none;
+    max-width: none;
+    padding: clamp(1rem, 3vw, 2.25rem);
+    padding-bottom: 12rem;
+    border: 1px solid var(--border);
+    border-radius: 1.2rem;
+    color: var(--text);
+    background: radial-gradient(ellipse 80% 24rem at top left, #4c3020, transparent), var(--bg);
+}
+
+.main-content:has(.device-detail) { max-width: 1320px; }
+.device-detail button { touch-action: manipulation; }
+.device-detail :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+.listening-title { font-size: clamp(1.75rem, 5vw, 3.2rem); line-height: 1.1; letter-spacing: -.04em; }
+.device-detail .section-title { color: var(--text); font-size: 1.1rem; letter-spacing: 0; text-transform: none; }
+.device-detail .preset-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .8rem; }
+.device-detail .preset-slot {
+    flex-direction: column;
+    align-items: stretch;
+    padding: .6rem .6rem 2.2rem;
+    border-radius: .85rem;
+    min-width: 0;
+    border-bottom-color: var(--border);
+}
+.device-detail .preset-thumb {
+    flex: none;
+    width: 100%;
+    height: auto;
+    aspect-ratio: 1;
+    border-radius: .5rem;
+}
+.device-detail .preset-source-label { font-size: .65rem; opacity: 1; }
+.device-detail .preset-name { font-size: .88rem; color: var(--text); }
+.device-detail .preset-slot.active {
+    --accent-fg: #ffd6a4;
+    background: #47301f;
+    border-color: var(--accent);
+    box-shadow: 0 0 1rem #ffab5938;
+}
+.device-detail .preset-slot.active .preset-name { color: var(--accent-fg); }
+.device-detail .preset-num {
+    top: .85rem;
+    right: .85rem;
+    background: #17110e;
+    color: #fff6ec;
+    padding: .16rem .46rem;
+    border-radius: 1rem;
+    opacity: 1;
+    font-size: .75rem;
+}
+.device-detail .preset-slot.active .preset-num { color: #fff6ec; }
+.device-detail .preset-slot-wrap.active .preset-edit-btn,
+.device-detail .preset-slot-wrap.active .preset-save-btn { color: #ffd6a4; }
+.device-detail .preset-edit-wrap { right: 2rem; }
+.device-detail .preset-edit-btn,
+.device-detail .preset-save-btn { min-width: 1.75rem; min-height: 1.75rem; }
+.device-detail .recents-section { margin-top: 2rem; }
+.speaker-options { margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; }
+.speaker-options > summary { cursor: pointer; font-weight: 600; }
+
+.playback-dock {
+    position: fixed;
+    z-index: 12;
+    bottom: max(.6rem, env(safe-area-inset-bottom));
+    left: 50%;
+    transform: translateX(-50%);
+    width: min(1260px, calc(100% - 1.2rem));
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(18rem, 1.15fr);
+    align-items: center;
+    border: 1px solid #594334;
+    border-radius: 1rem;
+    background: #211914;
+    box-shadow: 0 8px 32px #0009;
+}
+.playback-dock .now-playing,
+.playback-dock .controls {
+    margin: 0;
+    min-height: 0;
+    border: 0;
+    background: transparent;
+    box-shadow: none;
+}
+.playback-dock .now-playing { padding-right: 2.8rem; }
+.playback-dock .album-art { width: 3.4rem; height: 3.4rem; }
+.playback-dock .transport { justify-content: center; gap: clamp(.15rem, 1vw, .5rem); margin-bottom: .25rem; }
+.playback-dock .ctrl-btn { border-radius: 50%; }
+.playback-dock .play-btn { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
+.playback-dock .now-playing-fav-overlay { top: auto; bottom: calc(100% + 6px); }
+.playback-dock .track-details[open] {
+    max-height: 22vh;
+    overflow: auto;
+}
+
+@media (max-width: 950px) {
+    .device-detail .preset-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (max-width: 640px) {
+    .main-content:has(.device-detail) { padding: .6rem; }
+    .device-detail { padding-bottom: 17rem; }
+    .device-detail .preset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    .playback-dock { grid-template-columns: minmax(0, 1fr); }
+    .playback-dock .now-playing { padding-block: .6rem .25rem; }
+    .playback-dock .controls { padding-block: .3rem .65rem; }
+    .playback-dock .ctrl-btn { width: 2.25rem; height: 2.25rem; }
+    .playback-dock .play-btn { width: 2.65rem; height: 2.65rem; }
+}
